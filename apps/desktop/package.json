{
  "name": "@survey-synth/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm --filter @survey-synth/contracts build && pnpm run typecheck && electron-vite build",
    "typecheck": "pnpm --filter @survey-synth/contracts build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "pnpm --filter @survey-synth/contracts build && vitest run test --exclude test/python-engine-real.test.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dsnp/parquetjs": "1.9.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@googleapis/drive": "22.0.0",
    "@googleapis/forms": "7.0.0",
    "@survey-synth/contracts": "workspace:*",
    "@survey-synth/domain": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "google-auth-library": "11.0.2",
    "lucide-react": "^1.39.0",
    "react": "^19.1.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.87.0",
    "recharts": "3.8.0",
    "shadcn": "^4.20.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "0.31.10",
    "electron": "44.2.0",
    "electron-vite": "5.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
