{
  "name": "@survey-synth/sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "import": "./dist/forms/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/rpc/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @survey-synth/contracts build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @survey-synth/contracts build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run test"
  },
  "dependencies": {
    "@survey-synth/contracts": "workspace:*",
    "@survey-synth/domain": "workspace:*",
    "@survey-synth/statistics": "workspace:*",
    "@survey-synth/synthesis-core": "workspace:*",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "exceljs": "^4.4.0",
    "highs": "1.15.2"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
