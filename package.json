{
  "name": "survey-synth",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @survey-synth/desktop dev",
    "check": "node scripts/check.mjs",
    "format": "prettier --write \"apps/desktop/**/*.{ts,tsx,css,html,json}\" \"packages/{domain,contracts}/**/*.{ts,json}\" \"scripts/*.mjs\" \"*.{json,yaml,yml,ts,mjs}\"",
    "format:check": "prettier --check \"apps/desktop/**/*.{ts,tsx,css,html,json}\" \"packages/{domain,contracts}/**/*.{ts,json}\" \"scripts/*.mjs\" \"*.{json,yaml,yml,ts,mjs}\"",
    "lint": "eslint apps/desktop packages/domain packages/contracts --max-warnings=0",
    "typecheck": "pnpm run build:packages && pnpm --filter @survey-synth/desktop typecheck",
    "build": "pnpm run build:packages && pnpm --filter @survey-synth/desktop build",
    "build:desktop": "pnpm --filter @survey-synth/desktop build",
    "build:packages": "pnpm --filter @survey-synth/domain build && pnpm --filter @survey-synth/contracts build",
    "test": "pnpm run build:packages && pnpm --filter @survey-synth/contracts test && pnpm --filter @survey-synth/desktop test",
    "db:generate": "pnpm --filter @survey-synth/desktop db:generate",
    "engine:install": "python -m pip install -r engine/requirements.txt -r engine/requirements-build.txt",
    "engine:test": "python -m unittest discover -s engine -p \"test_*.py\"",
    "engine:smoke": "python engine/main.py selftest --work-dir .local-engine-smoke",
    "engine:electron-smoke": "pnpm --filter @survey-synth/desktop exec vitest run test/python-engine-real.test.ts",
    "engine:build": "cd engine && python -m PyInstaller survey-synth-engine.spec --noconfirm --clean",
    "engine:binary-smoke": "node scripts/engine-binary-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "fast-check": "4.5.3",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}