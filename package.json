{
  "name": "survey-synth",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "check": "node scripts/check.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.{mjs,json}\" \"tests/**/*.{ts,tsx,mjs,json}\" \"*.{json,yaml,yml,ts,mjs}\" \"src-tauri/**/*.json\" && cargo fmt --all",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.{mjs,json}\" \"tests/**/*.{ts,tsx,mjs,json}\" \"*.{json,yaml,yml,ts,mjs}\" \"src-tauri/**/*.json\"",
    "rust:format:check": "cargo fmt --all -- --check",
    "lint": "eslint apps packages scripts tests --max-warnings=0",
    "typecheck": "pnpm run build:packages && pnpm --recursive --if-present typecheck",
    "boundaries": "node scripts/check-boundaries.mjs",
    "versions": "node scripts/check-versions.mjs",
    "build": "pnpm run build:sidecar && pnpm --filter @survey-synth/desktop build",
    "build:packages": "pnpm --filter @survey-synth/domain build && pnpm --filter @survey-synth/contracts build && pnpm --filter @survey-synth/statistics build && pnpm --filter @survey-synth/synthesis-core build && pnpm --filter @survey-synth/test-support build",
    "test": "pnpm run test:typescript && cargo test --workspace",
    "test:typescript": "pnpm run build:packages && pnpm --filter @survey-synth/contracts test && pnpm --filter @survey-synth/synthesis-core test && pnpm --filter @survey-synth/sidecar test && pnpm --filter @survey-synth/desktop test && pnpm run test:integration",
    "rust:check": "cargo check --workspace && cargo clippy --workspace --all-targets -- -D warnings",
    "build:sidecar": "pnpm run build:packages && pnpm --filter @survey-synth/sidecar build",
    "test:integration": "pnpm run build:sidecar && pnpm exec vitest run tests/integration",
    "tauri:dev": "node scripts/tauri-dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@survey-synth/contracts": "workspace:*",
    "@survey-synth/sidecar": "workspace:*",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.35.0",
    "fast-check": "4.5.3",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
